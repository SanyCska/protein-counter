# TLS для мини-аппа. Telegram открывает Mini App только по https, поэтому перед
# стеком стоит Caddy: он слушает 80/443, сам получает и продлевает сертификат
# Let's Encrypt и раздаёт фронт, отправляя /api на бэкенд.
#
# Имя хоста берётся из переменной MINIAPP_HOST (см. docker-compose.yml); деплой
# выводит её из секрета WEBAPP_URL. По умолчанию это sslip.io-имя — IP сервера,
# записанный через дефисы: sslip.io резолвит такие имена в сам IP, регистрировать
# домен не нужно. Переезд на свой домен = A-запись на сервер плюс новое значение
# WEBAPP_URL, править этот файл не придётся.
#
# Фронт и API живут на одном origin: CORS не нужен, а VITE_API_BASE остаётся '/api'.

{$MINIAPP_HOST} {
	# Префикс /api не срезаем — роутеры FastAPI зарегистрированы вместе с ним.
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}

	encode gzip
}
