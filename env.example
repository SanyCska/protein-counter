TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
OPENAI_API_KEY=sk-...
# Optional: model for AI estimates (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional: IANA timezone for “today” (default: UTC)
# TZ=Europe/Berlin
# Optional: SQLite path (default: data/protein.sqlite3 locally; in Docker use /app/data/protein.sqlite3)
# PROTEIN_DB_PATH=data/protein.sqlite3

# ─── Mini App ───
# Public HTTPS address of the frontend. Without it the bot works as before,
# just without the mini app button.
# WEBAPP_URL=https://nutrition.example.com
# Comma-separated origins allowed to call the API (default: local Vite).
# In production the deploy falls back to WEBAPP_URL when this is empty.
# WEBAPP_ORIGINS=https://nutrition.example.com
# Host name for the TLS proxy (docker-compose caddy service). The deploy derives
# it from WEBAPP_URL; set it by hand only when running the prod stack locally.
# MINIAPP_HOST=nutrition.example.com
# Set to "dev" to allow the X-Dev-User-Id header instead of Telegram initData.
# APP_ENV=dev
